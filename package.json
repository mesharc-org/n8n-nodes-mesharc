{
	"name": "n8n-nodes-mesharc",
	"version": "0.2.0",
	"description": "n8n nodes for MeshArc, the web crawler: scrape, crawl, map and search the web, and start workflows when a watched site changes.",
	"license": "MIT",
	"homepage": "https://mesharc.dev",
	"keywords": [
		"n8n-community-node-package",
		"mesharc",
		"web-scraping",
		"web-crawler",
		"markdown",
		"change-detection",
		"website-monitoring"
	],
	"author": {
		"name": "MeshArc",
		"email": "hello@mesharc.dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mesharc-org/n8n-nodes-mesharc.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MeshArcApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/MeshArc/MeshArc.node.js",
			"dist/nodes/MeshArcTrigger/MeshArcTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.52.5",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "21.1.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
